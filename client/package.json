{
  "name": "air-and-water-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "vite --port 3000",
    "serve": "vite preview --port 3000 --strictPort"
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 firefox version"
  ],
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "@tensorflow-models/posenet": "2.2.2",
    "@tensorflow/tfjs-core": "^3.21.0",
    "@tensorflow/tfjs-converter": "^3.21.0",
    "@tensorflow/tfjs-backend-webgl": "^3.21.0",
    "p5": "^1.11.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-p5": "^1.4.1",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/p5": "^1.7.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
